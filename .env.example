# ==============================================================================
# Sentinel-EDR - Backend Environment Configuration Example
# Copy this file to .env for local configuration overrides.
# Do not store sensitive secrets, tokens, or encryption keys in this template.
# ==============================================================================

# Application Metadata
APP_NAME=Sentinel-EDR
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server Network Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Database Configuration (SQLite local path or connection URL)
DATABASE_URL=sqlite:///.data/sentinel_edr.db

# YARA Signature Scanner Configuration
YARA_RULES_DIR=rules/yara
YARA_ENABLED=false
YARA_SCAN_TIMEOUT_SECONDS=30
YARA_MAX_FILE_SIZE_BYTES=104857600

# Analysis Queue and Worker Configuration
ANALYSIS_QUEUE_CAPACITY=100
ANALYSIS_WORKER_COUNT=2
ANALYSIS_WORKERS_ENABLED=true
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=0.5
ANALYSIS_RECOVER_INTERRUPTED_ON_STARTUP=false

# PE Feature Extraction Configuration (T013)
PE_MAX_FILE_SIZE_BYTES=104857600
